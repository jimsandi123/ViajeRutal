                <input type="number" id="admTipoCapacidad" value="4" min="1" max="40">
            </div>
            <button id="btnAgregarTipo" class="btn primary">Agregar tipo</button>
            <p class="feedback" id="admTipoMsg"></p>
        </div>
    </div>

    <div id="atab-duplicados" class="admin-panel" style="display:none">
