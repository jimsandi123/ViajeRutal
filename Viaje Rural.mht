            <input type="text" id="admBuscarConductor" placeholder="Buscar por nombre, ID, teléfono o cédula...">
            <div id="listaConductores"></div>
        </div>
    </div>

    <div id="atab-pendientes" class="admin-panel" style="display:none">
        <div class="panel">
            <h3>⏳ Conductores en revisión / pendientes de activar cuenta</h3>
            <div id="listaPendientes"></div>
        </div>
    </div>

    <div id="atab-tipos" class="admin-panel" style="display:none">
        <div class="panel">
            <h3>🚗 Gestión de Tipos de Vehículo</h3>
            <div id="listaTiposVehiculo"></div>
            <hr>
            <label>Nuevo tipo de vehículo</label>
