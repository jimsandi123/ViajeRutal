<!-- ============ VISTA DEL CONDUCTOR ============ -->
<div id="view-conductor" class="screen" style="display:none">
    <div class="topbar">
        <span class="role-badge driver">Conductor</span>
        <span id="conductorNombre"></span>
        <details class="topbar-menu">
            <summary aria-label="Más opciones">⋮</summary>
            <div class="topbar-menu-items">
                <button id="btnGuiasCond" class="btn ghost small">📖 Guías</button>
                <button id="btnCompartirCond" class="btn ghost small" title="Compartir por WhatsApp">📲 Compartir</button>
            </div>
        </details>
        <button id="btnHistorialCond" class="btn ghost small">🕘</button>
        <button id="btnAjustesCond" class="btn ghost small">⚙️</button>
        <button id="btnSalirConductor" class="btn ghost small">Salir</button>
