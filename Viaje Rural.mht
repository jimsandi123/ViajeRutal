                <input id="chatInpCond" placeholder="Escribe un mensaje (indicaciones, llegada...)">
                <button id="btnSendCond" class="btn small">Enviar</button>
            </div>
        </div>
        <div id="chatCondVacio" class="empty-state"><span class="empty-icon">🚘</span><b>Sin viajes activos</b><span>El chat aparecerá cuando aceptes una solicitud.</span></div>
    </section>
    <nav class="bottom-nav" aria-label="Navegación de conductor">
        <button class="nav-item active" data-cond-tab="inicio">🚘<span>Inicio</span></button>
        <button class="nav-item" data-cond-tab="mapa">🗺️<span>Mapa</span></button>
        <button class="nav-item" data-cond-tab="chat">💬<span>Chat</span></button>
        <button class="nav-item" id="btnPerfilCondNav">👤<span>Perfil</span></button>
    </nav>
</div>

