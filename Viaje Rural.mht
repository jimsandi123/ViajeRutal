                <div id="chatMsgsPas" class="chat-msgs"></div>
                <div class="chat-row">
                    <input id="chatInpPas" placeholder="Escribe un mensaje (indicaciones, llegué...)">
                    <button id="btnSendPas" class="btn small">Enviar</button>
