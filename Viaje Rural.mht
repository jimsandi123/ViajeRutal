        <span id="licCondDias" class="lic-mini"></span>
    </div>

    <!-- ALERTA DE NUEVA SOLICITUD (solo le llega si es el turno)
         con cuenta regresiva de 15 segundos y reconocimiento del pasajero -->
    <div id="alertaViaje" class="alert-card" style="display:none">
        <div class="alert-title">🔔 Nueva solicitud de viaje</div>
        <div class="alerta-pass">
            <img id="alertaFotoPas" alt="" class="rv-avatar">
            <div>
                <b id="alertaPasNombre"></b>
                <div class="t-mini" id="alertaCantPas"></div>
            </div>
        </div>
        <div class="t-mini" id="alertaOrigen"></div>
        <div class="t-mini" id="alertaReferencia"></div>
        <div class="t-mini" id="alertaDestino"></div>
        <div class="t-mini" id="alertaDist"></div>
        <div class="t-mini" id="alertaTiempo">⏱ Tienes <b>15</b> segundos para responder</div>
        <div class="btn-row">
            <button id="btnAceptarAlerta" class="btn primary big">Aceptar solicitud</button>
            <button id="btnRechazarAlerta" class="btn ghost big">Dejar pasar</button>
        </div>
    </div>

    <div id="finArribaWrap" style="display:none">
        <button id="btnFinalizarViaje" class="btn danger big">🏁 Finalizar viaje</button>
    </div>
    <div id="condCancelNotice" class="panel cancel-notice" style="display:none">El pasajero canceló este viaje.</div>

    <!-- estado inactivo -->
    <div id="panelEspera" class="panel" style="display:none">
        <h3>👀 Esperando solicitudes</h3>
        <p class="t-mini">Se te notificará cuando un viaje coincida con tu vehículo y sea tu turno. Mantente activo.</p>
    </div>

    <!-- viaje activo asignado -->
    <div id="panelActivo" style="display:none" class="panel">
        <h3>📍 Viaje asignado</h3>
        <div class="recogida">
            <img id="tripFotoPas" alt="" class="rv-avatar lg">
            <div>
                <b id="tripPasNombre"></b>
                <div class="t-mini" id="tripPasTel"></div>
            </div>
        </div>
        <p id="tripDetalle"></p>
        <button id="btnAbrirPin" class="btn primary" style="display:none">🚗 Recoger pasajero</button>
        <div id="pinValidBox" style="display:none">
            <label>🔢 Al llegar, ingresa el PIN de 3 dígitos que te indique el pasajero</label>
            
            <div class="otp" aria-label="PIN de tres dígitos">
                <input maxlength="1" inputmode="numeric" data-otp="0" aria-label="Primer dígito del PIN">
                <input maxlength="1" inputmode="numeric" data-otp="1" aria-label="Segundo dígito del PIN">
                <input maxlength="1" inputmode="numeric" data-otp="2" aria-label="Tercer dígito del PIN">
            </div>
            <p class="feedback" id="pinValidMsg"></p>
            <button id="btnConfirmarPin" class="btn primary" style="display:none">🧭 Iniciar viaje hacia el destino</button>
        </div>
    </div>
    </section>
    <section class="app-section" data-cond-view="mapa">
        <div class="map-wrap">
            <div id="mapConductor" class="map cond-map" style="display:none"></div>
            <button id="btnToggleMapaCond" class="btn map-toggle">🗺️ Ver mapa</button>
