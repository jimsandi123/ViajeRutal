            <h3>⚠️ Conductores Duplicados</h3>
            <p class="t-mini">Detección automática por cédula, teléfono/WhatsApp o correo electrónico.</p>
            <div id="listaDuplicados"></div>
        </div>
    </div>

    <div id="atab-pasajeros" class="admin-panel" style="display:none">
        <div class="panel">
            <h3>Pasajeros registrados</h3>
            <div id="listaPasajerosAdmin"></div>
        </div>
    </div>

    <div id="atab-viajes" class="admin-panel" style="display:none">
        <div class="panel">
            <h3>Viajes en sistema</h3>
            <div id="listaViajesAdmin"></div>
        </div>
    </div>
</div>








