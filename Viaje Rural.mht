            <div class="field"><label>Tipo de vehículo</label>
                <select id="admCondTipo"><option value="">Selecciona tipo</option><option value="auto">🚗 Automóvil</option><option value="automvilypickupcarga">🚗 Automóvil y Pick up/ carga</option><option value="buseta">🚐 Buseta</option><option value="carga">🛻 Pick up / Carga</option><option value="moto">🛵 Motocicleta (moto)</option></select>
            </div>
            <input type="text" id="admCondMarca" placeholder="Marca del vehículo">
            <input type="text" id="admCondColor" placeholder="Color del vehículo">
            <input type="text" id="admCondPlaca" placeholder="Placa (matrícula)">
